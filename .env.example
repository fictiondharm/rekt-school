# DeFi Quest Environment Configuration
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
RPC_URL_SERVER=https://api.devnet.solana.com

# Solana RPC endpoints (client + server). Public endpoints, no API key required.
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Faucets (Devnet Server-side Keypairs)
FAUCET_MINT_AUTHORITY_SECRET=
GAS_TREASURY_SECRET=

# Programs and Mints (Devnet)
AMM_PROGRAM_ID=
FUSDC_MINT=

# Monitoring (Optional)
POSTHOG_KEY=
SENTRY_DSN=

# Hackathon Payment (Mainnet Reference Verification - Day 8)
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
PAYMENT_RECEIVER_ADDRESS=
USDC_MAINNET_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAYMENT_PRICE_USDC=1

# Access Gate (false during Days 1-8 development, set to true on Day 9)
ACCESS_GATE_ENABLED=false

