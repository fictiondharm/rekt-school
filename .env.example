# DeFi Quest Environment Configuration
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
RPC_URL_SERVER=https://api.devnet.solana.com

# Solana RPC endpoints (client + server). Public endpoints, no API key required.
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Supabase Auth & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Faucets (Devnet Server-side Keypairs)
# FAUCET_MINT_AUTHORITY_SECRET = base58 secret key of the keypair that OWNS mint authority
# for FUSDC_MINT. Used by /api/faucet/token to mint real fUSDC into student ATAs.
FAUCET_MINT_AUTHORITY_SECRET=
GAS_TREASURY_SECRET=

# Programs and Mints (Devnet)
# FUSDC_MINT = the devnet SPL Token mint used as the course's "fake USDC".
# Its mint authority must equal the public key of FAUCET_MINT_AUTHORITY_SECRET above.
AMM_PROGRAM_ID=
FUSDC_MINT=

# Monitoring (Optional)
POSTHOG_KEY=
SENTRY_DSN=

# Hackathon Payment (Mainnet Reference Verification - Day 8)
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
PAYMENT_RECEIVER_ADDRESS=
USDC_MAINNET_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAYMENT_PRICE_USDC=1

# Access Gate — ON by default: only B1 + I1 are free, the rest require a paid
# unlock ($1 USDC/SOL on Solana, $1 USDC/ETH on Base) or an invite code.
# Set either flag to false to disable the gate locally.
NEXT_PUBLIC_ACCESS_GATE_ENABLED=true
ACCESS_GATE_ENABLED=true

# Optional: an unlimited master unlock code you can hand out to anyone.
# Leave blank to disable. (Seeded DB codes have their own use limits.)
OWNER_UNLOCK_CODE=

